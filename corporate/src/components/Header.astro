---
/**
 * Site header. This file is the reference shape for the four zatsit sites:
 * corporate, the blog, the sustainability portal and the tech watcher all
 * render the same bar, so a visitor moving between them never re-learns it.
 *
 * Left to right, and in this order everywhere:
 *   1. brand: sigle plus the "zatsit" wordmark, the wordmark only from `lg`
 *   2. page navigation, collapsed behind the menu button below `lg`
 *   3. ecosystem icons, always visible: the two sibling sites, then LinkedIn,
 *      GitHub, mail
 *   4. theme toggle
 *   5. menu button, below `lg` only
 *
 * Only the navigation entries and the two sibling sites differ from site to
 * site. Here the siblings are the blog and the sustainability portal.
 *
 * The icons stay in the bar at every width rather than hiding below `md`:
 * they used to be unreachable from a phone, since the menu panel carried none
 * of them. Five 44px targets plus the toggle and the menu button do not fit a
 * 375px row, so `.header-action` is 36px wide below `sm` and square from
 * there. The metrics live in global.css and are shared with the other three
 * sites; do not restate them here.
 */
import { BLOG_URL, LINKEDIN_URL, GITHUB_URL, SUSTAINABILITY_URL } from 'astro:env/client';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LinkedinIcon from '../assets/icons/linkedin.svg';
import GithubIcon from '../assets/icons/github.svg';
import SustainabilityIcon from '../assets/icons/sustainability.svg';
import { ArrowUpRight, ChevronDown, CodeXml, Compass, ExternalLink, FilePenLine, Mail, Menu, Package, X } from '@lucide/astro';
import { isPageDisabled } from '../lib/pages';

interface NavLink {
  href: string;
  label: string;
  external?: boolean;
}

/** One card of the "Rejoins-nous" mega menu. */
interface JoinUsItem {
  href: string;
  label: string;
  description: string;
  icon: typeof Package;
}

const joinUsItems: JoinUsItem[] = [
  { href: '/join-us/', label: 'Ton package', description: 'Zatsday, mutuelle prise en charge à 100 %, matériel durable.', icon: Package },
  { href: '/careers/', label: 'Carrière', description: 'Nos rôles types et les chemins pour évoluer avec nous.', icon: Compass },
  { href: '/work-with-us/', label: 'Postuler', description: 'Le formulaire pour nous envoyer ta candidature.', icon: FilePenLine },
].filter(item => !isPageDisabled(item.href.replace(/^\/|\/$/g, '')));

/** Where the mega menu sits in the bar, replacing a plain link. */
const JOIN_US_SLOT = '#join-us';

const navLinks: NavLink[] = [
  { href: '/', label: 'Accueil' },
  { href: '/team/', label: 'L\'équipe' },
  { href: '/tech/', label: 'Notre tech' },
  { href: JOIN_US_SLOT, label: 'Rejoins-nous' },
];

// Filter out disabled pages
const filteredNavLinks = navLinks.filter(link => {
  if (link.href === JOIN_US_SLOT) return joinUsItems.length > 0;
  if (link.href === '/' || link.href === '/legal-notice/' || link.href === '/privacy-policy/') {
    return true;
  }
  const slug = link.href.replace(/^\/|\/$/g, '');
  return !isPageDisabled(slug);
});

/** `/` matches exactly, the rest by prefix, and a trailing slash never matters. */
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string, external = false) => {
  if (external) return false;
  const target = href.replace(/\/+$/, '') || '/';
  return target === '/' ? currentPath === '/' : currentPath.startsWith(target);
};
const isJoinUsCurrent = joinUsItems.some(item => isCurrent(item.href));
---

<header class="header glass" role="banner">
  <nav class="container header-nav" aria-label="Navigation principale">
    <a href="/" class="header-brand" aria-label="zatsit, accueil">
      <Logo class="header-logo" />
      <span class="header-wordmark">zatsit</span>
    </a>

    <ul class="header-links">
      {filteredNavLinks.map(link => link.href === JOIN_US_SLOT ? (
        <li class="mega-item">
          {/* Disclosure pattern, not an ARIA menu: the panel holds plain links,
              so Tab walks through them like anywhere else on the page. */}
          <button
            type="button"
            id="mega-join-btn"
            class={isJoinUsCurrent ? 'mega-trigger link-primary' : 'mega-trigger nav-link'}
            aria-expanded="false"
            aria-controls="mega-join"
          >
            {link.label}
            <ChevronDown class="icon-sm mega-chevron" aria-hidden="true" />
          </button>
          {/* Right after its button, so Tab reaches the cards next. It is
              positioned against the sticky header, not this item, so it
              spans the whole bar. Desktop only: below `lg` the mobile panel
              lists the same entries. */}
          <div id="mega-join" class="mega-panel" hidden>
            <div class="container mega-inner">
              <div class="mega-intro">
                <p class="mega-eyebrow">Rejoins-nous</p>
                <p class="mega-title">Rejoins le <span class="text-gradient">collectif</span></p>
                <p class="mega-tagline">Chez <strong>zatsit</strong>, nous prenons soin de ceux qui font l'entreprise.</p>
              </div>
              <ul class="mega-cards" aria-label="Rejoins-nous">
                {joinUsItems.map((item, index) => (
                  <li style={`--i: ${index}`}>
                    <a href={item.href} class="mega-card" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    <span class="mega-card-top" aria-hidden="true">
                      <span class="mega-card-icon"><item.icon class="icon-md" /></span>
                      <span class="mega-card-index">{String(index + 1).padStart(2, '0')}</span>
                    </span>
                    <span class="mega-card-label">
                      {item.label}
                      <ArrowUpRight class="icon-sm mega-card-arrow" aria-hidden="true" />
                    </span>
                    <span class="mega-card-description">{item.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ) : (
        <li>
          <a
            href={link.href}
            class={isCurrent(link.href, link.external) ? 'link-primary' : 'nav-link'}
            aria-current={isCurrent(link.href, link.external) ? 'page' : undefined}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
            {link.external && (
              <>
                <ExternalLink class="icon-sm inline-block ml-1 align-middle" aria-hidden="true" />
                <span class="sr-only">, dans un nouvel onglet</span>
              </>
            )}
          </a>
        </li>
      ))}
    </ul>

    <div class="header-actions">
      <ul class="header-ecosystem">
        <li>
          <a
            href={BLOG_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="header-action"
            aria-label="Notre blog, dans un nouvel onglet"
          >
            <CodeXml class="icon-md" aria-hidden="true" />
          </a>
        </li>
        <li>
          <a
            href={SUSTAINABILITY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="header-action"
            aria-label="Le portail Sustainability, dans un nouvel onglet"
          >
            <SustainabilityIcon class="icon-md" aria-hidden="true" />
          </a>
        </li>
        <li>
          <a
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="header-action"
            aria-label="Notre page LinkedIn, dans un nouvel onglet"
          >
            <LinkedinIcon class="icon-md" aria-hidden="true" />
          </a>
        </li>
        <li>
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="header-action"
            aria-label="Notre GitHub, dans un nouvel onglet"
          >
            <GithubIcon class="icon-md" aria-hidden="true" />
          </a>
        </li>
        <li>
          <a
            href="mailto:contact@zatsit.fr"
            class="header-action"
            aria-label="Écrire à contact@zatsit.fr"
          >
            <Mail class="icon-md" aria-hidden="true" />
          </a>
        </li>
      </ul>

      <ThemeToggle />

      <button
        id="mobile-menu-btn"
        class="mobile-menu-btn"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu class="icon-md menu-open-icon" aria-hidden="true" />
        <X class="icon-md menu-close-icon hidden" aria-hidden="true" />
      </button>
    </div>
  </nav>

  {/* Navigation only: the ecosystem icons and the mail link stay in the bar at
      every width, so repeating them here would be a duplicate. */}
  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul class="container mobile-menu-content">
      {filteredNavLinks.map(link => link.href === JOIN_US_SLOT ? (
        <li>
          <p class="mobile-nav-group-title" id="mobile-join-title">{link.label}</p>
          <ul class="mobile-mega-cards" aria-labelledby="mobile-join-title">
            {joinUsItems.map(item => (
              <li>
                <a href={item.href} class="mobile-mega-card" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span class="mega-card-icon" aria-hidden="true"><item.icon class="icon-sm" /></span>
                  <span>
                    <span class="mega-card-label">{item.label}</span>
                    <span class="mega-card-description">{item.description}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ) : (
        <li>
          <a
            href={link.href}
            class={isCurrent(link.href, link.external) ? 'link-primary text-lg py-2' : 'mobile-nav-link'}
            aria-current={isCurrent(link.href, link.external) ? 'page' : undefined}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
            {link.external && (
              <>
                <ExternalLink class="icon-sm inline-block ml-1 align-middle" aria-hidden="true" />
                <span class="sr-only">, dans un nouvel onglet</span>
              </>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.querySelector('.menu-open-icon');
    const closeIcon = document.querySelector('.menu-close-icon');
    if (!btn || !menu) return;

    // The label follows the state, so a screen reader announces what the next
    // click does rather than what the button opened last time.
    function setOpen(open: boolean) {
      btn!.setAttribute('aria-expanded', String(open));
      btn!.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      (menu as HTMLElement).hidden = !open;
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    }

    setOpen(false);
    btn.addEventListener('click', () => {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes the panel and hands focus back, so a keyboard user is never
    // stranded inside something they cannot see.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || btn.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      btn.focus();
    });
  }

  function initMegaMenu() {
    const btn = document.getElementById('mega-join-btn');
    const panel = document.getElementById('mega-join');
    if (!btn || !panel) return;

    const isOpen = () => btn.getAttribute('aria-expanded') === 'true';
    function setOpen(open: boolean) {
      btn!.setAttribute('aria-expanded', String(open));
      panel!.hidden = !open;
    }

    setOpen(false);
    btn.addEventListener('click', () => setOpen(!isOpen()));

    const item = btn.closest('.mega-item');
    const isInside = (node: Node | null) => !!node && !!item?.contains(node);

    document.addEventListener('click', (event) => {
      if (isOpen() && !isInside(event.target as Node)) setOpen(false);
    });

    // Tabbing past the last card closes the panel instead of leaving it open
    // over the page.
    item?.addEventListener('focusout', (event) => {
      if (!isInside((event as FocusEvent).relatedTarget as Node | null)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      setOpen(false);
      btn.focus();
    });
  }

  initMobileMenu();
  initMegaMenu();
  document.addEventListener('astro:after-swap', () => {
    initMobileMenu();
    initMegaMenu();
  });
</script>
