---
/**
 * A Google Form behind a click. The embed pulls about 8 MB (Google's scripts
 * and fonts), so it only loads once the visitor asks for it; until then the
 * page stays at its own weight. The direct link is always there, with or
 * without JavaScript.
 */
interface Props {
  /** The `viewform?embedded=true` URL of the form. */
  url: string;
  /** Accessible name of the iframe. */
  title: string;
  /** Label of the button that loads the form. */
  action: string;
}

const { url, title, action } = Astro.props;
---

<div class="embedded-form" data-embedded-form>
  <div class="embedded-form-gate">
    <button type="button" class="btn-primary" data-embedded-form-load>{action}</button>
    <p class="text-muted text-sm">
      Pour garder la page légère, le formulaire ne se charge qu'à la demande.
    </p>
  </div>
  <template data-embedded-form-template>
    <div class="form-wrapper">
      <iframe src={url} title={title} width="100%" height="900"></iframe>
    </div>
  </template>
  <p class="text-center text-muted text-sm mt-4">
    <a href={url} target="_blank" rel="noopener noreferrer" class="link-primary">
      Ouvrir le formulaire dans un nouvel onglet
    </a>
  </p>
</div>

<script>
  function initEmbeddedForms() {
    document.querySelectorAll<HTMLElement>('[data-embedded-form]').forEach((root) => {
      const button = root.querySelector<HTMLButtonElement>('[data-embedded-form-load]');
      const template = root.querySelector<HTMLTemplateElement>('[data-embedded-form-template]');
      const gate = root.querySelector<HTMLElement>('.embedded-form-gate');
      if (!button || !template || !gate) return;
      button.addEventListener('click', () => {
        const form = template.content.cloneNode(true) as DocumentFragment;
        gate.replaceWith(form);
        // Hand focus to the form so a keyboard user lands where the action went
        root.querySelector('iframe')?.focus();
      }, { once: true });
    });
  }

  initEmbeddedForms();
  document.addEventListener('astro:after-swap', initEmbeddedForms);
</script>

<style>
  .embedded-form-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 3rem 1.5rem;
    text-align: center;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
  }

  .form-wrapper {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  [data-theme="dark"] .form-wrapper {
    border: 1px solid var(--color-border);
  }

  .form-wrapper iframe {
    color-scheme: light;
  }
</style>
