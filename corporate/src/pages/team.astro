---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { Heart, CalendarHeart, FileText, Rocket, ShieldCheck, CodeXml, Leaf, HeartHandshake } from '@lucide/astro';
import { isPageDisabled } from '../lib/pages';
import { readFileSync } from 'node:fs';
import { MEDIA_BASE_URL } from 'astro:env/server';

const careersDisabled = isPageDisabled('careers')

const peopleData = await getEntry('people', 'people');
if (!peopleData) throw new Error('People data not found');
const { photos, contractTypes, testimonials, interviews } = peopleData.data;

const eventsData = await getEntry('events', 'events');
const events = eventsData?.data.events ?? [];

/** Plain-text transcript built from the captions, so the interview is readable without playing it. */
function readTranscript(slug: string): string {
  const vtt = readFileSync(`public/videos/team/${slug}.fr.vtt`, 'utf-8');
  return vtt
    .split('\n')
    .filter((line) => line.trim() !== '' && line !== 'WEBVTT' && !line.includes('-->'))
    .join(' ');
}

const interviewItems = interviews.map((interview) => ({
  ...interview,
  transcript: readTranscript(interview.slug),
}));

const contractIcons: Record<string, typeof Heart> = {
  document: FileText,
  freelance: Rocket,
  'shield-check': ShieldCheck,
};


---

<Layout title="Notre collectif" description="Découvrez le collectif zatsit : des dizaines de talents passionnés de tech, outillés pour le green IT et impliqués pour un numérique responsable.">
  <section class="section--hero !pb-10 md:!pb-16">
    <div class="hero-decoration">
      <div class="hero-blob hero-blob--primary"></div>
      <div class="hero-blob hero-blob--secondary"></div>
    </div>
    <div class="dot-grid"></div>

    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="section-title--lg hero-title break-words">
          Notre <span class="text-gradient-glow inline-block">collectif</span>
        </h1>
        <p class="section-description hero-subtitle">
          Des dizaines de talents qui partagent leur quotidien au sein d'une néo-ESN.
        </p>
      </div>
      <ul class="team-pillars">
        <li>
          <CodeXml class="icon-lg icon-primary" aria-hidden="true" />
          <span>Passionnés de <span class="text-gradient">tech</span></span>
        </li>
        <li>
          <Leaf class="icon-lg icon-primary" aria-hidden="true" />
          <span>Sensibilisés et outillés pour le <span class="text-gradient">green IT</span></span>
        </li>
        <li>
          <HeartHandshake class="icon-lg icon-primary" aria-hidden="true" />
          <span>Engagés pour un <span class="text-gradient">numérique responsable</span></span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section team-tight">
    <div class="carousel">
      <div class="carousel-track">
        {/* Double the photos for infinite scroll effect */}
        {[...photos, ...photos].map((photo, index) => (
          <div class="carousel-slide">
            <img
              src={photo.src}
              alt={photo.alt}
              loading={index < 3 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface team-tight">
    <div class="container team-collective">
      <div class="team-collective-text">
        <h2 class="section-title">Répartition des statuts</h2>
        <p class="text-muted">
          Devenir consultant <strong>zatsit</strong>, c'est prendre part au développement de l'entreprise, et évoluer parmi un collectif.
          Salarié, indépendant ou en portage, c'est toi qui choisis, et tu pourras passer d'un statut à l'autre si besoin.
        </p>
        <h3 class="team-collective-subtitle">Gouvernance partagée</h3>
        <p class="text-muted">
          L'ensemble du collectif est engagé dans les décisions prises par <strong>zatsit</strong>.
          Chaque dernier vendredi du mois, nous nous retrouvons lors du <strong class="text-gradient">Zatsday</strong> :
          une journée dédiée à la gouvernance, aux formations et aux retours d'expérience.
        </p>
        {!careersDisabled && (
          <a href="/careers/" class="btn-primary">
            Rejoindre le collectif
          </a>
        )}
      </div>
      <div id="profile-triangle" class="orbit-triangle mx-auto">
        {contractTypes.map((contract, index) => {
          const IconComponent = contractIcons[contract.icon];
          return (
            <div
              class="partner-card active"
              data-index={index}
            >
              {IconComponent && <IconComponent class="partner-icon" />}
              <span class="partner-name">{contract.type}</span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--surface team-tight">
    <div class="container">
      <div class="team-heading">
        <Heart class="icon-lg icon-primary flex-shrink-0" size={28} aria-hidden="true" />
        <h2 class="section-title">Paroles de Zat's</h2>
      </div>
      {interviewItems.length > 0 ? (
        <ul class="interviews">
          {interviewItems.map((interview) => (
            <li class="card interview">
              <video
                class="interview-video"
                controls
                controlslist="nodownload"
                preload="none"
                playsinline
                poster={`/videos/team/${interview.slug}.avif`}
                width="1280"
                height="720"
                aria-label={`Interview de ${interview.name}, ${interview.role}`}
              >
                <source src={`${MEDIA_BASE_URL}/videos/team/${interview.media ?? interview.slug}.webm`} type="video/webm" />
                <source src={`${MEDIA_BASE_URL}/videos/team/${interview.media ?? interview.slug}.mp4`} type="video/mp4" />
                <track
                  kind="captions"
                  src={`/videos/team/${interview.slug}.fr.vtt`}
                  srclang="fr"
                  label="Français"
                  default
                />
              </video>
              <div class="interview-body">
                <h3 class="font-semibold">{interview.name}</h3>
                <p class="interview-meta">{interview.role}, {interview.duration}</p>
                <details class="interview-transcript">
                  <summary>Lire la transcription</summary>
                  <p>{interview.transcript}</p>
                </details>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 max-w-5xl mx-auto">
          {testimonials.map((testimonial) => (
            <div class="card p-4 md:p-6">
              <blockquote class="text-sm text-muted italic mb-4">
                "{testimonial.quote}"
              </blockquote>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-[var(--color-surface)] flex items-center justify-center">
                  <span class="font-semibold text-gradient">{testimonial.name[0]}</span>
                </div>
                <div>
                  <div class="font-semibold text-sm">{testimonial.name}</div>
                  <div class="text-xs text-muted">{testimonial.role}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  {events.length > 0 && (
    <section class="section team-tight" aria-labelledby="events-title">
      <div class="container">
        <div class="team-heading">
          <CalendarHeart class="icon-lg icon-primary flex-shrink-0" size={28} aria-hidden="true" />
          <h2 id="events-title" class="section-title">Nos événements</h2>
        </div>
        <ul class="team-events">
          {events.map((event, eventIndex) => (
            <li class="team-event">
              <div class="team-event-text">
                <p class="team-event-eyebrow">{event.eyebrow}</p>
                <h3 class="team-event-title">{event.title}</h3>
                <p class="text-muted">{event.description}</p>
                {event.quote && <blockquote class="team-event-quote">« {event.quote} »</blockquote>}
              </div>
              {event.photos.length > 0 && (
                /* Scroll-snap strip: no script, swipe on touch, arrow keys once focused */
                <div
                  class="team-event-strip"
                  role="region"
                  aria-label={`Photos : ${event.title}`}
                  tabindex="0"
                >
                  <ul>
                    {event.photos.map((photo) => (
                      <li>
                        <Image
                          src={photo.src}
                          alt={photo.alt}
                          widths={[480, 720]}
                          sizes="(min-width: 768px) 26rem, 80vw"
                          format="avif"
                          quality={40}
                          loading="lazy"
                        />
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {eventIndex < events.length - 1 && <hr class="team-event-separator" />}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>

<script>
  import { initOrbitTriangle } from '../scripts/orbit-triangle';

  const init = () => initOrbitTriangle('profile-triangle');
  init();
  document.addEventListener('astro:after-swap', init);
</script>

<style>
  /* Desktop condenses: the page is a sequence of short sections */
  @media (min-width: 1024px) {
    .team-tight { padding-block: 3.5rem; }
  }

  /* Icon and title on one baseline: .section-title carries a bottom margin
     that a utility cannot override, so it is reset here */
  .team-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .team-heading .section-title {
    margin-bottom: 0;
    line-height: 1.1;
  }

  .team-pillars {
    display: grid;
    gap: 1.5rem;
    max-width: 60rem;
    margin: 2.5rem auto 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }
  @media (min-width: 768px) {
    .team-pillars { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }
  .team-pillars li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    text-wrap: balance;
  }

  .team-collective {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }
  /* The triangle has a fixed width in global.css; never let it widen the column */
  .team-collective > .orbit-triangle {
    max-width: 100%;
    justify-self: center;
  }
  @media (min-width: 1024px) {
    .team-collective {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      column-gap: 4rem;
    }
  }
  .team-collective-text > * + * { margin-top: 1rem; }
  .team-collective-text .btn-primary { margin-top: 1.5rem; }
  .team-collective-subtitle {
    font-size: 1.25rem;
    font-weight: 600;
    padding-top: 0.5rem;
  }

  .interviews {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .interview {
    flex: 0 0 100%;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .interview { flex-basis: calc((100% - 1.5rem) / 2); }
  }
  @media (min-width: 1024px) {
    .interview { flex-basis: calc((100% - 3rem) / 3); }
  }
  .interview-video:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
  .interview-video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .interview-body {
    padding: 0.875rem 1.25rem 1rem;
  }
  /* Role and duration always on their own line, so every card has the same height */
  .interview-meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .interview-transcript {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }
  .interview-transcript summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    font-weight: 600;
    color: var(--color-primary);
    border-radius: var(--radius-md);
  }
  .interview-transcript summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .team-events {
    display: grid;
    gap: 3rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .team-event {
    display: grid;
    gap: 1.5rem;
  }
  .team-event-text {
    max-width: 48rem;
  }
  .team-event-text > * + * { margin-top: 0.75rem; }
  .team-event-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .team-event-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .team-event-quote {
    padding-left: 1rem;
    border-left: 3px solid var(--color-primary);
    font-style: italic;
  }

  /* Variable-width slides at a fixed height, so the portrait photo is not cropped */
  .team-event-strip {
    position: relative;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    border-radius: var(--radius-lg);
  }
  .team-event-strip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
  .team-event-strip ul {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0 0 0.75rem;
    list-style: none;
  }
  .team-event-strip li {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }
  .team-event-strip img {
    display: block;
    width: auto;
    max-width: 85vw;
    height: 16rem;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  @media (min-width: 768px) {
    .team-event-strip img { height: 20rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .team-event-strip { scroll-behavior: smooth; }
  }

  .team-event-separator {
    margin-top: 1.5rem;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .interview-transcript p {
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>
