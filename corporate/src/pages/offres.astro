---
import { getEntry } from 'astro:content';
import { ArrowDown, ArrowRight, ExternalLink } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import { isPageDisabled } from '../lib/pages';

const offersData = await getEntry('offers', 'offers');
if (!offersData) throw new Error('Offers data not found');
const { packages, refusals, proofs } = offersData.data;

const manifestoDisabled = isPageDisabled('manifeste');
const careersDisabled = isPageDisabled('careers');
---

<Layout
  title="Nos offres"
  description="Product engineering augmenté : quatre packages, de l'AI-readiness au projet spec-driven, avec la mesure GreenScore et des choix souverains quand ils tiennent."
>
  <section class="section--hero">
    <div class="hero-decoration">
      <div class="hero-blob hero-blob--primary"></div>
      <div class="hero-blob hero-blob--secondary"></div>
    </div>
    <div class="dot-grid"></div>

    <div class="container">
      <div class="max-w-4xl">
        <h1 class="offers-title hero-title">
          Construire avec l'IA,
          <span class="text-gradient-glow">sans y croire sur parole.</span>
        </h1>
        <p class="section-description hero-subtitle max-w-2xl">
          Des développeurs, des ops et des architectes seniors, embarqués dans vos équipes.
          La spec avant le code, le modèle choisi selon la tâche, la facture mesurée.
          Quatre packages pour entrer, un seul standard.
        </p>
        <div class="hero-cta flex flex-wrap gap-4">
          <a href="#entrees" class="btn-primary">
            Par où entrer
            <ArrowDown class="icon-sm" aria-hidden="true" />
          </a>
          <a href="/work-with-us/" class="btn-secondary">Travaillons ensemble</a>
        </div>
      </div>
    </div>
  </section>

  <section id="entrees" class="section scroll-mt-20" aria-labelledby="entrees-title">
    <div class="container">
      <h2 id="entrees-title" class="section-title">Par où entrer</h2>
      <p class="section-description max-w-2xl">
        Quatre situations, quatre packages. Choisissez la phrase qui vous ressemble.
      </p>
      <ul class="entries">
        {packages.map((pack) => (
          <li>
            <a href={`#${pack.id}`} class="entry">
              <span class="entry-situation">{pack.situation}</span>
              <span class="entry-package">
                {pack.title}
                <ArrowRight class="icon-sm" aria-hidden="true" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="packages-title">
    <div class="container">
      <div class="max-w-3xl mb-4">
        <h2 id="packages-title" class="section-title">Quatre packages, une méthode</h2>
        <p class="section-description">
          Chaque package dit ce que vous achetez, ce que vous recevez, ce que nous mesurons,
          et ce que nous faisons de souverain quand le contexte le permet. Rien de plus.
        </p>
      </div>

      {packages.map((pack) => (
        <article class="pack scroll-mt-20" id={pack.id} aria-labelledby={`${pack.id}-title`}>
          <div class="pack-head">
            <p class="pack-situation">{pack.situation}</p>
            <h3 id={`${pack.id}-title`} class="pack-title">{pack.title}</h3>
            <p class="pack-pitch">{pack.pitch}</p>
          </div>
          <dl class="pack-sheet">
            <div>
              <dt>Forme</dt>
              <dd>{pack.form}</dd>
            </div>
            <div>
              <dt>Livrable</dt>
              <dd>{pack.deliverable}</dd>
            </div>
            <div>
              <dt>Mesuré</dt>
              <dd>{pack.measured}</dd>
            </div>
            <div>
              <dt>Souverain, quand ça tient</dt>
              <dd>{pack.sovereign}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="section refusals" aria-labelledby="refusals-title">
    <div class="container">
      <div class="refusals-grid">
        <h2 id="refusals-title" class="refusals-title">Ce que nous ne vendons pas</h2>
        <ol class="refusals-list">
          {refusals.map((refusal) => (
            <li>
              <p class="refusal-claim">{refusal.claim}</p>
              <p class="refusal-why">{refusal.why}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="proofs-title">
    <div class="container">
      <div class="proofs-grid">
        <div>
          <h2 id="proofs-title" class="section-title">Ce que vous pouvez vérifier</h2>
          <p class="section-description !mb-0">
            Une page d'offres affirme. Celle-ci préfère pointer vers ce qui se vérifie.
          </p>
        </div>
        <ul class="proofs">
          {proofs.map((proof) => (
            <li>
              <p>{proof.text}</p>
              {proof.href && (
                <a href={proof.href} target="_blank" rel="noopener noreferrer" class="link-primary proof-link">
                  {proof.label}
                  <ExternalLink class="icon-sm" aria-hidden="true" />
                  <span class="sr-only">, dans un nouvel onglet</span>
                </a>
              )}
            </li>
          ))}
          {(!manifestoDisabled || !careersDisabled) && (
            <li>
              <p>
                Notre façon de travailler n'est pas réservée à nos clients.
                {!manifestoDisabled && (
                  <> Elle est écrite dans <a href="/manifeste/" class="link-primary">notre manifeste</a></>
                )}
                {!manifestoDisabled && !careersDisabled && <> et</>}
                {!careersDisabled && (
                  <> elle se lit dans <a href="/careers/" class="link-primary">les rôles que nous recrutons</a></>
                )}.
              </p>
            </li>
          )}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="contact-title">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <h2 id="contact-title" class="section-title">Dites-nous où vous en êtes</h2>
        <p class="section-description">
          Décrivez-nous votre situation. Nous vous dirons par quel package entrer,
          ou si aucun ne convient.
        </p>
        <a href="/work-with-us/" class="btn-primary">
          Travaillons ensemble
          <ArrowRight class="icon-sm" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .offers-title {
    font-size: clamp(2.25rem, 1.4rem + 4vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  /* Entry strip: one situation per package, the sentence is the control */
  .entries {
    display: grid;
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .entries { grid-template-columns: repeat(2, 1fr); column-gap: 3rem; }
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .entry:hover,
  .entry:focus-visible {
    color: var(--color-primary);
  }
  .entry:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: var(--radius-md);
  }
  .entry-situation {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }
  .entry-package {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .entry:hover .entry-package,
  .entry:focus-visible .entry-package {
    color: inherit;
  }

  /* Packages: a spec sheet per package, head on the left, fields on the right */
  .pack {
    display: grid;
    gap: 2rem;
    padding: 3rem 0;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 1024px) {
    .pack {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 5rem;
      padding: 4rem 0;
    }
  }
  .pack-situation {
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  .pack-title {
    font-size: clamp(1.625rem, 1.2rem + 1.4vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
    margin-bottom: 1rem;
    text-wrap: balance;
  }
  .pack-pitch {
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 60ch;
  }
  .pack-sheet {
    display: grid;
    gap: 1.75rem 2.5rem;
    align-content: start;
  }
  @media (min-width: 640px) {
    .pack-sheet { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .pack-sheet dt {
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.375rem;
  }
  .pack-sheet dd {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Refusals: the page inverts its own colors to say what it does not sell */
  .refusals {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .refusals-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .refusals-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 5rem;
    }
    .refusals-title {
      position: sticky;
      top: 7rem;
    }
  }
  .refusals-title {
    font-size: clamp(2rem, 1.3rem + 2.5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
    align-self: start;
    text-wrap: balance;
  }
  .refusals-list {
    list-style: none;
    padding: 0;
  }
  .refusals-list li {
    padding: 1.75rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-bg) 25%, transparent);
  }
  .refusals-list li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .refusal-claim {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.5rem;
    text-wrap: balance;
  }
  .refusal-why {
    color: color-mix(in srgb, var(--color-bg) 72%, var(--color-text));
    line-height: 1.6;
    max-width: 60ch;
  }

  /* Proofs */
  .proofs-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .proofs-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 5rem;
    }
  }
  .proofs {
    list-style: none;
    padding: 0;
  }
  .proofs li {
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .proofs li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .proof-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    font-size: 1rem;
    min-height: 44px;
  }

  @media (prefers-reduced-motion: reduce) {
    .entry { transition: none; }
  }
</style>
