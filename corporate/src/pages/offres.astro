---
import { getEntry } from 'astro:content';
import { ArrowDown, ArrowRight, ChevronLeft, ChevronRight, ExternalLink, Gauge, ShieldCheck } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import { isPageDisabled } from '../lib/pages';
import { withBoldBrand, withBoldTerms } from '../lib/brand';

const offersData = await getEntry('offers', 'offers');
if (!offersData) throw new Error('Offers data not found');
const { hero, method, packages, foundation, refusalsTitle, refusals, proofsTitle, proofsIntro, proofs, cta } = offersData.data;

const manifestoDisabled = isPageDisabled('manifeste');
const careersDisabled = isPageDisabled('careers');
const teamDisabled = isPageDisabled('team');

// A proof may point to a page this build hides
const proofHref = (href?: string) => (href === '/team/' && teamDisabled ? undefined : href);

// The method pipeline, in order. Every package covers a subset of it.
const STATIONS = [
  { key: 'spec', label: 'Spec' },
  { key: 'code', label: 'Code' },
  { key: 'test', label: 'Test' },
  { key: 'deploiement', label: 'Déploiement' },
  { key: 'mesure', label: 'Mesure' },
] as const;

const stationLabels = (keys: readonly string[]) =>
  STATIONS.filter((station) => keys.includes(station.key)).map((station) => station.label).join(', ');
---

<Layout
  title="Nos offres"
  description="L'IA écrit du code, quelqu'un doit en répondre. Quatre Enablers AI (audit maturité IA, pilote spec-driven, désendettement, dev augmenté) posés sur nos deux métiers : le conseil et l'ingénierie augmentée."
>
  <section class="section--hero !pb-10 md:!pb-16">
    <div class="hero-decoration">
      <div class="hero-blob hero-blob--primary"></div>
      <div class="hero-blob hero-blob--secondary"></div>
    </div>
    <div class="dot-grid"></div>

    <div class="container">
      <div class="max-w-4xl">
        <h1 class="offers-title hero-title">
          {hero.title}
          <span class="text-gradient-glow">{hero.highlight}</span>
        </h1>
        <p class="section-description hero-subtitle max-w-2xl" set:html={withBoldTerms(hero.subtitle, ['Product Engineers', 'Forward Deployed Engineers'])} />
        <div class="hero-cta flex flex-wrap gap-4">
          <a href="#packages" class="btn-primary">
            {hero.primaryCta}
            <ArrowDown class="icon-sm" aria-hidden="true" />
          </a>
          <a href="/work-with-us/" class="btn-secondary">{hero.secondaryCta}</a>
        </div>
      </div>
    </div>
  </section>

  {/* Runs while the page is parsed, before the pipeline below is painted, so
      the first frame already shows the pending state: no flash of the drawn
      rail before the animation. Without JS or with reduced motion, the
      attribute is never set and everything renders final. */}
  <script is:inline data-astro-rerun>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      document.documentElement.setAttribute('data-reveal-js', '');
    }
  </script>

  {/* The method: five stations on one rail. The rail draws once, at mid viewport. */}
  <section id="methode" class="method" aria-labelledby="method-title">
    <div class="container">
      <div class="method-head">
        <div>
          <p class="method-eyebrow">{method.eyebrow}</p>
          <h2 id="method-title" class="method-title">{method.title}</h2>
        </div>
        <p class="method-caption">{method.caption}</p>
      </div>
      <ol class="pipeline" data-reveal>
        {STATIONS.map((station, index) => (
          <li class="pipeline-station" style={`--i: ${index}`}>
            <span class="pipeline-dot" aria-hidden="true"></span>
            <span class="pipeline-label">{station.label}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* One package per section, hung on a vertical spine that continues the rail. */}
  <div class="packs" id="packages">
    {/* Sticks under the header while the packages scroll by. Plain anchors,
        so it works without JS; the script only marks the current package. */}
    <nav class="packs-toc" aria-label="Les quatre Enablers AI">
      <div class="container packs-toc-bar">
        {/* Revealed by the script: without JS the anchors alone do the job */}
        <button type="button" class="packs-toc-step" aria-label="Package précédent" data-toc-prev hidden>
          <ChevronLeft class="icon-md" aria-hidden="true" />
        </button>
        <ol>
          {packages.map((pack, index) => (
            <li>
              <a href={`#${pack.id}`} data-toc-link>
                <span class="packs-toc-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                {pack.navLabel}
              </a>
            </li>
          ))}
        </ol>
        <button type="button" class="packs-toc-step" aria-label="Package suivant" data-toc-next hidden>
          <ChevronRight class="icon-md" aria-hidden="true" />
        </button>
      </div>
    </nav>
    {packages.map((pack, index) => (
      <section class="pack" id={pack.id} aria-labelledby={`${pack.id}-title`}>
        <div class="container pack-grid">
          <div class="pack-side">
            <span class="pack-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <p class="pack-situation">{pack.situation}</p>
            <span class="sr-only">Étapes couvertes : {stationLabels(pack.stations)}.</span>
            <ol class="track" aria-hidden="true" data-reveal>
              {STATIONS.map((station, stationIndex) => {
                const on = pack.stations.includes(station.key);
                const next = STATIONS[stationIndex + 1];
                const linked = on && next !== undefined && pack.stations.includes(next.key);
                return (
                  <li class:list={['track-stop', { 'track-stop--on': on, 'track-stop--linked': linked }]} style={`--i: ${stationIndex}`}>
                    <span class="track-dot"></span>
                    <span class="track-label">{station.label}</span>
                  </li>
                );
              })}
            </ol>
            <p class="pack-roles-label">Qui vient chez vous</p>
            <ul class="pack-roles" aria-label="Rôles mobilisés">
              {pack.roles.map((role) => <li class="tag">{role}</li>)}
            </ul>
          </div>

          <div class="pack-main">
            <h2 id={`${pack.id}-title`} class="pack-title">{pack.title}</h2>
            <p class="pack-pitch" set:html={withBoldBrand(pack.pitch)} />

            <div class="pack-sheet">
              <div class="pack-deal">
                <p class="pack-field-label">Forme</p>
                <p class="pack-form">{pack.form}</p>
                <p class="pack-field-label">Livrable</p>
                <p class="pack-deliverable">{pack.deliverable}</p>
              </div>
              <dl class="pack-orient">
                <div>
                  <dt><Gauge class="icon-sm" aria-hidden="true" /> Mesuré</dt>
                  <dd>{pack.measured}</dd>
                </div>
                <div>
                  <dt><ShieldCheck class="icon-sm" aria-hidden="true" /> Souverain, si possible</dt>
                  <dd>{pack.sovereign}</dd>
                </div>
              </dl>
            </div>
            {pack.tree && (
              <ul class="repo-tree" aria-label="Contenu du dépôt livré">
                {pack.tree.map((entry) => (
                  <li>
                    <code>{entry.path}</code>
                    <span>{entry.note}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
    ))}
  </div>

  <section id="socle" class="section foundation" aria-labelledby="foundation-title">
    <div class="container">
      <div class="max-w-3xl mb-10">
        <h2 id="foundation-title" class="section-title">{foundation.title}</h2>
        <p class="section-description !mb-0">{foundation.intro}</p>
      </div>
      <ul class="foundation-list">
        {foundation.offers.map((offer) => (
          <li class="card foundation-offer" id={offer.id}>
            <p class="foundation-situation">{offer.situation}</p>
            <h3 class="foundation-title">{offer.title}</h3>
            <p class="foundation-pitch" set:html={withBoldBrand(offer.pitch)} />
            <p class="pack-field-label">Forme</p>
            <p class="foundation-form">{offer.form}</p>
            <p class="pack-roles-label">Qui vient chez vous</p>
            <ul class="pack-roles" aria-label="Rôles mobilisés">
              {offer.roles.map((role) => <li class="tag">{role}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section refusals" aria-labelledby="refusals-title">
    <div class="container refusals-grid">
      <h2 id="refusals-title" class="refusals-title">{refusalsTitle}</h2>
      <ol class="refusals-list">
        {refusals.map((refusal) => (
          <li>
            <p class="refusal-claim">{refusal.claim}</p>
            <p class="refusal-why" set:html={withBoldBrand(refusal.why)} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="proofs-title">
    <div class="container">
      <div class="max-w-3xl mb-10">
        <h2 id="proofs-title" class="section-title">{proofsTitle}</h2>
        <p class="section-description !mb-0">{proofsIntro}</p>
      </div>
      <ul class="proofs">
        {proofs.map((proof) => (
          <li class="proof">
            <p class="proof-lead">{proof.lead}</p>
            <p class="proof-text" set:html={withBoldBrand(proof.text)} />
            {proofHref(proof.href) && (proof.href!.startsWith('/') ? (
              <a href={proof.href} class="link-primary proof-link">
                {proof.label}
                <ArrowRight class="icon-sm" aria-hidden="true" />
              </a>
            ) : (
              <a href={proof.href} target="_blank" rel="noopener noreferrer" class="link-primary proof-link">
                {proof.label}
                <ExternalLink class="icon-sm" aria-hidden="true" />
                <span class="sr-only">, dans un nouvel onglet</span>
              </a>
            ))}
          </li>
        ))}
      </ul>
      {(!manifestoDisabled || !careersDisabled) && (
        <p class="proofs-more">
          Notre façon de travailler n'est pas réservée à nos clients.
          {!manifestoDisabled && (
            <> Elle est écrite dans <a href="/manifeste/" class="link-primary">notre manifeste</a></>
          )}
          {!manifestoDisabled && !careersDisabled && <> et</>}
          {!careersDisabled && (
            <> elle se lit dans <a href="/careers/" class="link-primary">les rôles que nous recrutons</a></>
          )}.
        </p>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <h2 id="contact-title" class="section-title">{cta.title}</h2>
        <p class="section-description">{cta.text}</p>
        <a href="/work-with-us/" class="btn-primary">
          {cta.button}
          <ArrowRight class="icon-sm" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // One-shot reveals: each [data-reveal] draws itself once it reaches the middle
  // of the viewport. The pending state comes from the inline script above.
  function initReveals() {
    if (!document.documentElement.hasAttribute('data-reveal-js')) return;

    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((target) => {
      if (target.dataset.reveal === 'done') return;
      const observer = new IntersectionObserver(
        (entries, obs) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          target.dataset.reveal = 'done';
          obs.disconnect();
        },
        { root: null, rootMargin: '-50% 0px -50% 0px', threshold: 0 },
      );
      observer.observe(target);
    });
  }

  document.addEventListener('astro:page-load', initReveals);

  // Marks the package crossing the middle of the viewport in the table of
  // contents, keeps that pill in view in the bar on narrow screens, and drives
  // the previous/next buttons from it.
  function initPacksToc() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    if (!links.length) return;
    const prev = document.querySelector<HTMLButtonElement>('[data-toc-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-toc-next]');
    const list = links[0].closest('ol');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = -1;

    const setCurrent = (index: number) => {
      current = index;
      links.forEach((link, i) => {
        if (i === index) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (prev) prev.disabled = index <= 0;
      if (next) next.disabled = index >= links.length - 1;
      // Horizontal only: scrollIntoView would also move the page
      // Measured from the list itself, not offsetLeft, whose origin is the sticky bar
      const link = links[index];
      if (list && link) {
        const linkBox = link.getBoundingClientRect();
        const listBox = list.getBoundingClientRect();
        const left = list.scrollLeft + linkBox.left - listBox.left - (list.clientWidth - linkBox.width) / 2;
        list.scrollTo({ left, behavior: reduceMotion ? 'auto' : 'smooth' });
      }
    };

    const goTo = (index: number) => {
      const target = links[index];
      if (!target) return;
      document.getElementById(target.hash.slice(1))?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
      history.replaceState(null, '', target.hash);
    };

    for (const button of [prev, next]) if (button) button.hidden = false;
    prev?.addEventListener('click', () => goTo(Math.max(current, 0) - 1));
    next?.addEventListener('click', () => goTo(current + 1));
    setCurrent(0);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = links.findIndex((link) => link.hash === `#${entry.target.id}`);
          if (index !== -1) setCurrent(index);
        }
      },
      { root: null, rootMargin: '-50% 0px -50% 0px', threshold: 0 },
    );
    for (const link of links) {
      const section = document.getElementById(link.hash.slice(1));
      if (section) observer.observe(section);
    }
  }

  document.addEventListener('astro:page-load', initPacksToc);
</script>

<style>
  .offers-title {
    font-size: clamp(2.25rem, 1.4rem + 4vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  /* ---- Method band: primary surface, on-primary text ---- */
  .method {
    padding: 4rem 0 5rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    overflow-x: clip;
  }
  @media (min-width: 768px) {
    .method { padding: 5rem 0 6rem; }
  }
  .method-head {
    display: grid;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 1024px) {
    .method-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 5rem;
      align-items: end;
    }
  }
  .method-eyebrow {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .method-title {
    font-size: clamp(2rem, 1.3rem + 2.5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
    text-wrap: balance;
  }
  .method-caption {
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 48ch;
    color: color-mix(in srgb, var(--color-on-primary) 82%, var(--color-primary));
  }

  .pipeline {
    --rail-y: 0.625rem;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pipeline-station {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  /* The rail: a faint base line, and a full-strength line drawn over it */
  .pipeline-station::before,
  .pipeline-station::after {
    content: "";
    position: absolute;
    top: var(--rail-y);
    left: 0;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }
  .pipeline-station::before {
    background: color-mix(in srgb, var(--color-on-primary) 25%, transparent);
  }
  .pipeline-station::after {
    background: var(--color-on-primary);
    transform-origin: left center;
  }
  .pipeline-station:last-child::before,
  .pipeline-station:last-child::after {
    width: 50%;
  }
  .pipeline-dot {
    position: relative;
    z-index: 1;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--color-on-primary);
    box-shadow: 0 0 0 6px var(--color-primary);
  }
  .pipeline-label {
    font-size: clamp(1rem, 0.6rem + 1.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  /* Small screens: the rail turns vertical, stations stacked, labels full size */
  @media (max-width: 639px) {
    .pipeline {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
    .pipeline-station {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      padding-bottom: 1.5rem;
    }
    .pipeline-station::before,
    .pipeline-station::after {
      top: 0.625rem;
      left: calc(0.625rem - 1px);
      width: 2px;
      height: 100%;
      transform: none;
    }
    .pipeline-station::after { transform-origin: top center; }
    .pipeline-station:last-child { padding-bottom: 0; }
    .pipeline-station:last-child::before,
    .pipeline-station:last-child::after { display: none; }
    .pipeline-label { font-size: 1.125rem; }
    html[data-reveal-js] .pipeline:not([data-reveal="done"]) .pipeline-station::after {
      transform: scaleY(0);
    }
    html[data-reveal-js] .pipeline:not([data-reveal="done"]) .pipeline-label {
      transform: translateX(0.5rem);
    }
  }
  /* Reveal: the rail draws station by station, the dots pop in */
  .pipeline[data-reveal] .pipeline-station::after {
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1) calc(var(--i) * 0.45s + 0.3s);
  }
  .pipeline[data-reveal] .pipeline-dot,
  .pipeline[data-reveal] .pipeline-label {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i) * 0.45s), opacity 0.4s ease calc(var(--i) * 0.45s);
  }
  html[data-reveal-js] .pipeline:not([data-reveal="done"]) .pipeline-station::after {
    transform: translateY(-50%) scaleX(0);
  }
  html[data-reveal-js] .pipeline:not([data-reveal="done"]) .pipeline-dot {
    transform: scale(0);
  }
  html[data-reveal-js] .pipeline:not([data-reveal="done"]) .pipeline-label {
    opacity: 0;
    transform: translateY(0.5rem);
  }

  /* ---- Packages hung on a vertical spine ---- */
  .packs {
    position: relative;
  }
  .pack {
    padding: 4rem 0;
    position: relative;
    /* The sticky table of contents, on top of the html scroll-padding that
       already clears the header */
    scroll-margin-top: 4.5rem;
  }

  .packs-toc {
    position: sticky;
    /* Right under the header bar */
    top: var(--header-h);
    z-index: 40;
    border-block: 1px solid var(--color-border);
    background: var(--color-bg);
    box-shadow: 0 6px 16px -12px rgb(0 0 0 / 0.35);
  }
  .packs-toc-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.5rem;
  }
  .packs-toc ol {
    display: flex;
    flex: 1;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin: 0;
    /* Room for the focus ring and the pill's rounded ends inside the clip */
    padding: 4px;
    list-style: none;
  }
  .packs-toc a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    white-space: nowrap;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .packs-toc a:hover { color: var(--color-text); background: var(--color-surface); }
  .packs-toc a:focus-visible,
  .packs-toc-step:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  /* Current package: a filled pill plus aria-current, never colour alone */
  .packs-toc a[aria-current] {
    color: var(--color-on-primary);
    background: var(--color-primary);
  }
  .packs-toc-index {
    font-variant-numeric: tabular-nums;
    font-weight: 400;
  }
  .packs-toc-step {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 2px solid var(--color-text-muted);
    border-radius: 999px;
    color: var(--color-text);
    background: transparent;
    cursor: pointer;
  }
  .packs-toc-step[hidden] { display: none; }
  .packs-toc-step:hover:not(:disabled) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .packs-toc-step:disabled {
    opacity: 0.35;
    cursor: default;
  }
  /* nth-of-type: the table of contents is the first child of .packs */
  .pack:nth-of-type(even) {
    background: var(--color-surface);
  }
  @media (min-width: 1024px) {
    .pack { padding: 5.5rem 0; }
  }
  .pack-grid {
    display: grid;
    gap: 2.5rem;
  }
  /* Below the two-column layout, the side column dissolves so the roles can
     follow the package sheet instead of preceding its title */
  @media (max-width: 1023px) {
    .pack-side { display: contents; }
    .pack-side .pack-roles-label,
    .pack-side .pack-roles { order: 1; }
    .pack-side .pack-roles-label { margin-top: 0; }
    .pack-side .track { margin-bottom: 0.5rem; }
  }
  @media (min-width: 1024px) {
    .pack-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 5rem;
    }
    .pack-side {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
    /* The spine runs through the side column, from one package to the next */
    .pack-side::before {
      content: "";
      position: absolute;
      left: 0.5rem;
      top: -5.5rem;
      bottom: -5.5rem;
      width: 2px;
      background: color-mix(in srgb, var(--color-primary) 30%, transparent);
    }
    .pack:first-child .pack-side::before { top: 0.75rem; }
    .pack:last-child .pack-side::before { bottom: auto; height: calc(100% + 5.5rem); }
    .pack-side { padding-left: 2.5rem; position: relative; }
    .pack-side::after {
      content: "";
      position: absolute;
      left: 0;
      top: 0.75rem;
      width: 1.125rem;
      height: 1.125rem;
      border-radius: 50%;
      background: var(--color-primary);
      box-shadow: 0 0 0 5px var(--color-bg);
    }
