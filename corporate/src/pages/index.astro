---
import { getEntry } from 'astro:content';
import {
  ArrowRight, CalendarDays, ExternalLink, GraduationCap, Lightbulb, Martini, Mic, Newspaper, PartyPopper, Shuffle, Users, Vote,
} from '@lucide/astro';
import { BLOG_URL, GITHUB_URL } from 'astro:env/client';
import { Image } from 'astro:assets';
import ecovadisMedal from '../assets/ecovadis-medal.webp';
import bcorpBlackUrl from '../assets/bcorp-black.svg?url';
import bcorpLightUrl from '../assets/bcorp-light.svg?url';
import Layout from '../layouts/Layout.astro';
import { isPageDisabled } from '../lib/pages';
import { withBoldBrand } from '../lib/brand';
import { getBlogPostCount } from '../lib/blog';
import { HOME_TITLE, SITE_DESCRIPTION } from '../consts';

// The previous home stays reachable at /home-previous/, hidden from indexing.

const offersData = await getEntry('offers', 'offers');
const contributionsData = await getEntry('contributions', 'contributions');
const trainingsData = await getEntry('trainings', 'trainings');
if (!offersData || !contributionsData || !trainingsData) throw new Error('Home content not found');

const { packages, foundation, cta } = offersData.data;
const { talks, projects } = contributionsData.data;
const { trainings } = trainingsData.data;
const blogPostCount = await getBlogPostCount();

// A link to a page this build hides disappears, and so does its call to action
const shows = (slug: string) => !isPageDisabled(slug);
const offersShown = shows('offers');
const contactShown = shows('work-with-us');

// French typography: a narrow no-break space before ? ! : ; and inside « »
const NNBSP = ' ';
const frenchSpaces = (text: string) => text.replace(/ ([?!:;])/g, `${NNBSP}$1`);
const quote = (text: string) => `«${NNBSP}${frenchSpaces(text)}${NNBSP}»`;

// Home-only wording of the four answers, for readers who do not code. The
// full offers, with their technical vocabulary, stay on /offers/.
const HOME_ANSWERS: Record<string, { title?: string; pitch: string }> = {
  'ai-maturity-audit': {
    pitch: "Nous passons du temps dans votre équipe pour voir comment l'IA y est déjà utilisée, et ce qu'elle vous coûte. Vous repartez avec une feuille de route classée par priorité.",
  },
  'sdd-pilot': {
    title: 'Un pilote sur un vrai projet',
    pitch: 'Nous appliquons la méthode sur un périmètre de votre choix, avec des seniors dans votre équipe. À la fin, vous jugez sur le code livré.',
  },
  'debt-reduction': {
    title: 'Le coût du code oublié',
    pitch: 'Nous lisons votre code pour trouver ce qui consomme sans servir : dépendances mortes, requêtes inutiles, ressources oubliées. Vous obtenez une liste chiffrée en euros.',
  },
  'augmented-development': {
    title: "L'IA installée dans vos équipes",
    pitch: "Nous installons chez vous notre façon de travailler avec l'IA : cadrer, relire, mesurer. Une équipe pilote d'abord, les autres ensuite si les résultats suivent.",
  },
};
// The fifth situation answers with both historical offers at once
const FOUNDATION_SITUATION = "J'ai besoin de renfort, ou d'un avis d'architecte.";
const FOUNDATION_PITCHES: Record<string, string> = {
  consulting: 'Une décision technique lourde à prendre : nos profils les plus expérimentés viennent la challenger avec vous, en direct.',
  'augmented-engineer': "Des ingénieurs qualifiés rejoignent vos équipes pour construire, avec la pratique de l'IA que nous appliquons chez nous.",
};
const foundationAnswers = foundation.offers.map((offer) => ({
  id: offer.id,
  title: offer.title,
  pitch: frenchSpaces(FOUNDATION_PITCHES[offer.id] ?? offer.pitch),
}));

const answers = packages.map((pack) => ({
  id: pack.id,
  navLabel: pack.navLabel,
  situation: pack.situation,
  title: HOME_ANSWERS[pack.id]?.title ?? pack.title,
  pitch: frenchSpaces(HOME_ANSWERS[pack.id]?.pitch ?? pack.pitch),
}));

// The team's rituals, as /team/ tells them
const RITUALS = [
  { icon: CalendarDays, when: 'Chaque dernier vendredi du mois', what: "Les Zatsdays : formations tech, résultats de l'entreprise, prises de parole libres et bénévolat associatif." },
  { icon: Martini, when: 'Chaque mois', what: 'Un AfterWork avec tout le collectif : quiz, fléchettes, bowling, initiation au cocktail.' },
  { icon: PartyPopper, when: 'Septembre 2026', what: 'Deux jours en baie de Somme pour fêter nos trois ans, sous une météo bien picarde.' },
] as const;

// What joining changes, as the current home and /join-us/ tell it
const PILLARS = [
  { icon: Users, name: "9 ans d'expérience", line: 'en moyenne, entre développeurs, ops et architectes' },
  { icon: Vote, name: 'Gouvernance partagée', line: "les choix de l'entreprise se discutent ensemble" },
  { icon: Shuffle, name: 'Statut au choix', line: 'salarié, indépendant ou en portage' },
  { icon: Lightbulb, name: 'Initiatives portées', line: 'une idée qui plaît au collectif, son auteur la mène' },
] as const;

// Event names without their edition: "Cloud Nord 2026" and "Cloud Nord 2024" count once
const talkEvents = [...new Set(talks.map((talk) => talk.event.replace(/\s+(\d{4}|#\d+)$/, '')))];
const listInFrench = (items: string[]) =>
  items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} et ${items[items.length - 1]}`;

// The closing title lights its second clause, like the current home's last call
const [closeLead, closeAccent] = (() => {
  const cut = cta.title.indexOf(', ');
  return cut < 0 ? [cta.title, ''] : [cta.title.slice(0, cut + 2), cta.title.slice(cut + 2)];
})();
---

<Layout title={HOME_TITLE} description={SITE_DESCRIPTION}>
  {/* ---- Hero: the promise, then the visitor's own situation ---- */}
  <section class="home2-hero" aria-labelledby="home2-title">
    {/* The previous home's atmosphere: dot grid, warm mesh and drifting blobs */}
    <div class="dot-grid" aria-hidden="true"></div>
    <div class="hero-gradient" aria-hidden="true"></div>
    <div class="hero-decoration" aria-hidden="true">
      <div class="hero-blob hero-blob--primary"></div>
      <div class="hero-blob hero-blob--secondary"></div>
    </div>
    <div class="container">
      <h1 id="home2-title" class="home2-title">
        Livrer avec l'IA,<br />
        <span class="text-gradient-glow">sans perdre la main.</span>
      </h1>
      <p
        class="home2-lead"
        set:html={withBoldBrand("zatsit est un collectif d'ingénieurs expérimentés. Nous installons l'IA dans vos équipes de développement, de l'écriture du besoin jusqu'à la mesure en production, et nous répondons du résultat.")}
      />

      <div class="situations" data-situations>
        <div class="situations-side">
          <h2 id="situations-title" class="situations-title">Où en êtes-vous{NNBSP}?</h2>
          <div class="situation-tabs" role="tablist" aria-labelledby="situations-title" aria-orientation="vertical">
            {answers.map((answer, index) => (
              <button
                type="button"
                role="tab"
                id={`situation-tab-${answer.id}`}
                class="situation-tab"
                aria-controls={`situation-panel-${answer.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
              >
                <span>{quote(answer.situation)}</span>
                <ArrowRight class="situation-tab-icon" aria-hidden="true" />
              </button>
            ))}
            <button
              type="button"
              role="tab"
              id="situation-tab-foundation"
              class="situation-tab"
              aria-controls="situation-panel-foundation"
              aria-selected="false"
              tabindex="-1"
            >
              <span>{quote(FOUNDATION_SITUATION)}</span>
              <ArrowRight class="situation-tab-icon" aria-hidden="true" />
            </button>
          </div>
        </div>

        <div class="situation-panels">
          {answers.map((answer, index) => (
            <div
              class="situation-panel"
              id={`situation-panel-${answer.id}`}
              role="tabpanel"
              aria-labelledby={`situation-tab-${answer.id}`}
              data-initial={index === 0 ? 'true' : undefined}
            >
              {/* Shown only without JavaScript, where the tabs are hidden */}
              <p class="panel-situation">{quote(answer.situation)}</p>
              <h3 class="panel-title">{answer.title}</h3>
              <p class="panel-pitch">{answer.pitch}</p>
              <div class="panel-actions">
                {contactShown && (
                  <a href="/work-with-us/" class="btn-on-primary">
                    Parlons-en
                    <ArrowRight class="icon-sm" aria-hidden="true" />
                  </a>
                )}
                {offersShown && (
                  <a href={`/offers/#${answer.id}`} class="panel-link">
                    Lire l'offre<span class="sr-only"> {answer.navLabel}</span>
                  </a>
                )}
              </div>
            </div>
          ))}
          <div
            class="situation-panel"
            id="situation-panel-foundation"
            role="tabpanel"
            aria-labelledby="situation-tab-foundation"
          >
            <p class="panel-situation">{quote(FOUNDATION_SITUATION)}</p>
            <h3 class="panel-title">Nos deux métiers historiques</h3>
            <ul class="panel-offers">
              {foundationAnswers.map((offer) => (
                <li>
                  <h4 class="panel-offer-title">{offer.title}</h4>
                  <p class="panel-offer-pitch">{offer.pitch}</p>
                  {offersShown && (
                    <a href={`/offers/#${offer.id}`} class="panel-link">
                      Lire l'offre<span class="sr-only"> {offer.title}</span>
                    </a>
                  )}
                </li>
              ))}
            </ul>
            {contactShown && (
              <div class="panel-actions">
                <a href="/work-with-us/" class="btn-on-primary">
                  Parlons-en
                  <ArrowRight class="icon-sm" aria-hidden="true" />
                </a>
              </div>
            )}
          </div>
        </div>

        <div class="situations-more">
          {contactShown && (
            <p>
              Votre situation n'est pas dans la liste{NNBSP}?
              <a href="/work-with-us/" class="inline-link">Décrivez-la-nous</a>
            </p>
          )}
        </div>
      </div>
    </div>
  </section>

  {/* ---- The team: the people behind the answers, and the candidates' door ---- */}
  <section class="section section--surface team" aria-labelledby="team-title">
    <div class="container">
      <div class="team-head">
        <div>
          <p class="eyebrow">Le collectif</p>
          <h2 id="team-title" class="block-title">
            Une équipe qui aime <span class="text-gradient-glow">se retrouver</span>
          </h2>
        </div>
        <div class="team-actions">
          {shows('join-us') && (
            <a href="/join-us/" class="btn-primary">
              Rejoindre l'équipe
              <ArrowRight class="icon-sm" aria-hidden="true" />
            </a>
          )}
          {shows('careers') && <a href="/careers/" class="inline-link">Voir nos rôles</a>}
        </div>
      </div>

      <ul class="pillars" data-light-up>
        {PILLARS.map((pillar) => (
          <li class="glow-tile is-lit">
            <pillar.icon class="glow-tile-icon" aria-hidden="true" />
            <p class="glow-tile-name">{pillar.name}</p>
            <p class="glow-tile-line">{pillar.line}</p>
          </li>
        ))}
      </ul>

      <ol class="rituals" aria-label="Nos rendez-vous">
        {RITUALS.map((ritual) => (
          <li class="ritual">
            <p class="ritual-when">
              <span class="ritual-icon" aria-hidden="true"><ritual.icon /></span>
              {ritual.when}
            </p>
            <p class="ritual-what">{frenchSpaces(ritual.what)}</p>
          </li>
        ))}
      </ol>
      {shows('team') && (
        <a href="/team/" class="arrow-link">Rencontrer l'équipe <ArrowRight class="icon-sm" aria-hidden="true" /></a>
      )}
    </div>
  </section>

  {/* ---- What a visitor can check without us ---- */}
  <section class="section" aria-labelledby="proofs-title">
    <div class="container">
      <p class="eyebrow">Les preuves</p>
      <h2 id="proofs-title" class="block-title proofs-title">
        Ce que vous pouvez <span class="text-gradient-glow">vérifier</span>
      </h2>
      <ul class="stats">
        <li class="stat">
          <Mic class="stat-icon" aria-hidden="true" />
          <p class="stat-figure"><span class="text-gradient-glow">{talks.length}</span> conférences</p>
          <p class="stat-line">Tenues par nos consultants à {listInFrench(talkEvents)}.</p>
          {shows('contributions') && <a href="/contributions/" class="arrow-link">Voir nos contributions <ArrowRight class="icon-sm" aria-hidden="true" /></a>}
        </li>
        <li class="stat">
          <GraduationCap class="stat-icon" aria-hidden="true" />
          <p class="stat-figure"><span class="text-gradient-glow">{trainings.length}</span> formations</p>
          <p class="stat-line">{listInFrench(trainings.map((training) => training.title))}, que nous donnons aussi à d'autres équipes.</p>
          {shows('trainings') && <a href="/trainings/" class="arrow-link">Consulter nos formations <ArrowRight class="icon-sm" aria-hidden="true" /></a>}
        </li>
        <li class="stat">
          <span class="stat-icon stat-icon--code" aria-hidden="true">&lt;/&gt;</span>
          <p class="stat-figure"><span class="text-gradient-glow">{projects.length}</span> projets open source</p>
          <p class="stat-line">{listInFrench(projects.map((project) => project.name))}, en accès libre.</p>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="arrow-link">
            Découvrir nos dépôts GitHub <ExternalLink class="icon-sm" aria-hidden="true" /><span class="sr-only">, dans un nouvel onglet</span>
          </a>
        </li>
        <li class="stat">
          <Newspaper class="stat-icon" aria-hidden="true" />
          <p class="stat-figure">
            {blogPostCount ? <><span class="text-gradient-glow">{blogPostCount}</span> articles de blog</> : 'Notre blog'}
          </p>
          <p class="stat-line">Écrits par l'équipe, sur l'IA, le code, l'architecture et le Green IT.</p>
          <a href={BLOG_URL} target="_blank" rel="noopener noreferrer" class="arrow-link">
            Lire le blog <ExternalLink class="icon-sm" aria-hidden="true" /><span class="sr-only">, dans un nouvel onglet</span>
          </a>
        </li>
      </ul>

      {/* The footer's two official marks, larger: the B Corp badge swaps file
          with the theme through the global .bcorp-badge rule */}
      <ul class="labels" aria-label="Nos labels">
        <li>
          <a
            href="https://www.bcorporation.net/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Entreprise certifiée B Corp, dans un nouvel onglet"
            class="bcorp-badge labels-bcorp"
            style={`--bcorp-black: url(${bcorpBlackUrl}); --bcorp-light: url(${bcorpLightUrl})`}
          ></a>
        </li>
        <li>
          <Image src={ecovadisMedal} alt="EcoVadis, médaille d'argent, top 15 %" width={100} height={100} densities={[1, 2]} class="labels-ecovadis" />
        </li>
      </ul>
    </div>
  </section>

  {/* ---- Close ---- */}
  {contactShown && (
    <section class="section section--surface close-section" aria-labelledby="close-title">
      <div class="hero-gradient" aria-hidden="true"></div>
      <div class="container">
        <div class="close">
          <h2 id="close-title" class="block-title">
            {closeLead}{closeAccent && <span class="text-gradient-glow">{closeAccent}</span>}
          </h2>
          <p class="block-intro">{frenchSpaces(cta.text)}</p>
          <a href="/work-with-us/" class="btn-primary">
            {cta.button}
            <ArrowRight class="icon-sm" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  // Situation selector: a vertical tab list. Without this script the tabs stay
  // hidden and every answer shows, each under its own situation.
  function initSituations() {
    const root = document.querySelector<HTMLElement>('[data-situations]');
    if (!root || root.classList.contains('is-ready')) return;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const stacked = window.matchMedia('(max-width: 1023px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const select = (index: number, focus: boolean) => {
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[tabIndex].hidden = !selected;
      });
      const panel = panels[index];
      panel.classList.remove('is-entering');
      // Restart the reveal on the panel that just appeared
      void panel.offsetWidth;
      panel.classList.add('is-entering');
      if (focus) tabs[index].focus();
      // Stacked layout: the answer sits under the list, bring it into view
      if (stacked.matches && panel.getBoundingClientRect().top > window.innerHeight * 0.6) {
        panel.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'nearest' });
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index, false));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const moves: Record<string, number> = {
          ArrowDown: index === last ? 0 : index + 1,
          ArrowRight: index === last ? 0 : index + 1,
          ArrowUp: index === 0 ? last : index - 1,
          ArrowLeft: index === 0 ? last : index - 1,
          Home: 0,
          End: last,
        };
        if (!(event.key in moves)) return;
        event.preventDefault();
        select(moves[event.key], true);
      });
    });

    panels.forEach((panel) => { panel.hidden = panel.dataset.initial !== 'true'; });
    root.classList.add('is-ready');
  }

  // Glowing tiles light up one after the other, once, when their row reaches
  // the middle of the viewport. The markup ships them lit, so they read in
  // full without JavaScript or with reduced motion.
  const lightUpObservers: IntersectionObserver[] = [];
  function initLightUps() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-light-up]').forEach((row) => {
      const tiles = [...row.querySelectorAll<HTMLElement>('.glow-tile')];
      tiles.forEach((tile) => tile.classList.remove('is-lit'));
      const observer = new IntersectionObserver(
        (entries, obs) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          tiles.forEach((tile, index) => setTimeout(() => tile.classList.add('is-lit'), index * 300));
          obs.disconnect();
        },
        // Middle-of-viewport trigger, stretched above so a fast jump still lands in it
        { root: null, rootMargin: '10000% 0px -50% 0px', threshold: 0 },
      );
      observer.observe(row);
      lightUpObservers.push(observer);
    });
  }

  document.addEventListener('astro:page-load', initSituations);
  document.addEventListener('astro:page-load', initLightUps);
  document.addEventListener('astro:before-swap', () => {
    lightUpObservers.forEach((observer) => observer.disconnect());
    lightUpObservers.length = 0;
  });
</script>

<style>
  /* ---- Hero ---- */
  .home2-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 3rem 0 4rem;
  }
  @media (min-width: 768px) {
    .home2-hero { padding: 3.5rem 0 5rem; }
  }
  .home2-title {
    font-size: clamp(2.5rem, 1.3rem + 4.2vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-wrap: balance;
  }
  .home2-lead {
    margin-top: 1.25rem;
    max-width: 54ch;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .home2-lead :global(strong) { color: var(--color-text); }

  /* ---- Situation selector ---- */
  .situations {
    display: grid;
    grid-template-areas: "side" "panels" "more";
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 1024px) {
    .situations {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-areas: "side panels" "more panels";
      grid-template-rows: auto 1fr;
      column-gap: 3rem;
      row-gap: 1.25rem;
    }
  }
  .situations-side { grid-area: side; }
  .situation-panels { grid-area: panels; }
  .situations-more { grid-area: more; }
  .situations-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .situation-tabs { display: grid; }
  /* Without JavaScript the tabs would do nothing: hide them, show every answer */
  .situations:not(.is-ready) .situation-tabs { display: none; }
  .situation-tab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.25rem;
    align-items: center;
    gap: 1rem;
    width: 100%;
    min-height: 44px;
    padding: 1rem 0.75rem;
    border-top: 1px solid var(--color-border);
    text-align: left;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.4;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .situation-tab:last-child { border-bottom: 1px solid var(--color-border); }
  .situation-tab:hover { color: var(--color-text); }
  .situation-tab[aria-selected='true'] {
    color: var(--color-text);
    font-weight: 600;
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }
  /* A gold tint turns muddy on the dark background: a neutral lift instead,
     the card surface, while the gold arrow and the weight carry the state */
  :global([data-theme="dark"]) .situation-tab[aria-selected='true'] {
    background: var(--card-bg);
  }
  .situation-tab:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .situation-tab :global(.situation-tab-icon) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-0.5rem);
    transition: opacity 0.2s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .situation-tab[aria-selected='true'] :global(.situation-tab-icon) {
    opacity: 1;
    transform: none;
  }
  .situations-more {
    display: grid;
    gap: 0.25rem;
    color: var(--color-text-muted);
  }
  .inline-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* The answer: the page's one full primary field */
  .situation-panels {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  /* With the tabs live, every panel shares one cell so the height never jumps */
  .situations.is-ready .situation-panel { grid-area: 1 / 1; }
  .situations.is-ready .situation-panel[hidden] {
    display: flex;
    visibility: hidden;
  }
  .situation-panel {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: 0 0 60px -12px color-mix(in srgb, var(--color-primary) 70%, transparent);
