---
import { ViewTransitions } from 'astro:transitions';
import { BaseHead } from '@zatsit/components';
import { GITHUB_URL, LINKEDIN_URL } from 'astro:env/client';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  ADDRESS,
  SITE_DESCRIPTION,
  SITE_INLANGUAGE,
  SITE_LANG,
  SITE_LOCALE,
  SITE_LOGO,
  SITE_OG_IMAGE,
  SITE_OG_IMAGE_ALT,
  SITE_OG_IMAGE_HEIGHT,
  SITE_OG_IMAGE_WIDTH,
  SITE_TITLE,
} from '../consts';
import '../styles/global.css';

/**
 * The two weights the first screen actually uses: 400 for the footnote and the
 * body, 700 for the hero heading. Imported as URLs so Vite hands back the
 * hashed filenames it emits, which a hand-written <link> could not know.
 *
 * 600 is deliberately not preloaded. It appears further down the page, and the
 * blog measured what over-preloading costs: six preloaded faces took a first
 * visit from 31.0 kB to 56.5 kB of fonts. Two here, not three.
 */
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Trail from the root to this page, excluding the page itself. */
  breadcrumbs?: { name: string; href: string }[];
  /**
   * Attaches the postal address to the organisation. Set on `/find-us/`, the
   * page that actually publishes it with a map, and nowhere else.
   */
  withAddress?: boolean;
  /** Set on pages that exist without being content, such as the 404 body. */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  breadcrumbs = [],
  withAddress = false,
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={SITE_LANG}>
  <head>
    <BaseHead
      title={title}
      description={description}
      siteName={SITE_TITLE}
      siteDescription={SITE_DESCRIPTION}
      inLanguage={SITE_INLANGUAGE}
      locale={SITE_LOCALE}
      image={SITE_OG_IMAGE}
      imageAlt={SITE_OG_IMAGE_ALT}
      imageWidth={SITE_OG_IMAGE_WIDTH}
      imageHeight={SITE_OG_IMAGE_HEIGHT}
      logo={SITE_LOGO}
      sameAs={[LINKEDIN_URL, GITHUB_URL]}
      address={withAddress ? ADDRESS : undefined}
      breadcrumbs={breadcrumbs}
      sitemap="/sitemap.xml"
      noindex={noindex}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Without these the fonts are only discovered once the stylesheet has
        parsed, which delays the first text paint. `crossorigin` is required
        even same-origin, or the browser fetches the file a second time. */}
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin />

    {/* Colours the mobile browser chrome. Keyed on the OS preference rather
        than on our `data-theme`, which a meta tag cannot read, so it can
        disagree with a reader who overrode the theme by hand. No SEO effect
        either way. */}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1b1d" media="(prefers-color-scheme: dark)" />

    <ViewTransitions />

    <!-- Theme persistence -->
    <script is:inline>
      function applyTheme() {
        const theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">
      Aller au contenu principal
    </a>

    <Header />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
